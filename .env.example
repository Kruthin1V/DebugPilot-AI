# AI CareerPilot Environment Configuration

# Backend API Configuration
PROJECT_NAME="AI CareerPilot"
ENVIRONMENT="development"
DEBUG=True
PORT=8000
HOST="127.0.0.1"

# Database Configuration
DATABASE_URL="sqlite:///./careerpilot.db"

# Gemini AI API Key (REQUIRED for Phase 2 AI Features)
# Obtain your key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY="your_gemini_api_key_here"
GEMINI_MODEL="gemini-2.5-flash"

# Security & Upload Constraints
MAX_UPLOAD_SIZE_MB=5
ALLOWED_EXTENSIONS=["pdf"]
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173"]
